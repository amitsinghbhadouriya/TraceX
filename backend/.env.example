PORT=3000
MONGODB_URI=mongodb://localhost:27017/tracex
JWT_SECRET=change_this_to_a_random_secret_64chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=change_this_to_another_random_secret
REFRESH_TOKEN_EXPIRES_IN=7d
ML_ENGINE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=50
NODE_ENV=development
BCRYPT_ROUNDS=12

# ── Seeder ────────────────────────────────────────────────────────────────────
SEED_INVESTIGATOR_PASSWORD=<choose_a_strong_password>

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RL_AUTH_IP_WINDOW_MIN=15
RL_AUTH_IP_MAX=10
RL_AUTH_ACCOUNT_WINDOW_MIN=60
RL_AUTH_ACCOUNT_MAX=5
RL_AUTH_BACKOFF_BASE_SEC=2
RL_AUTH_BACKOFF_MULTIPLIER=2
RL_AUTH_BACKOFF_MAX_SEC=3600
RL_PUBLIC_WINDOW_MIN=15
RL_PUBLIC_MAX=60
RL_AUTHED_WINDOW_MIN=15
RL_AUTHED_MAX=300
RL_UPLOAD_WINDOW_MIN=1
RL_UPLOAD_MAX=5
RL_CHAT_WINDOW_MIN=1
RL_CHAT_MAX=20
RL_ANALYSIS_WINDOW_MIN=60
RL_ANALYSIS_MAX=10
