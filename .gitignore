# TraceX monorepo — root .gitignore
# Each sub-project also has its own .gitignore; this catches anything that
# slips through at the root level.

# ── Environment & Secrets — NEVER commit these ──────────────────────────────
**/.env
**/.env.local
**/.env.*.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
*.pem
*.key
*.cert
*.pfx
*.p12
credentials.json
service-account*.json
google-services.json
client_secret*.json

# Allow templates in any sub-directory (without real secrets)
!**/.env.example

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
.venv.bak/

# ── Data files & Datasets — NEVER commit customer/financial data ───────────
*.csv
*.tsv
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.xlsx
*.xls
*.xlsm
*.sqlite
*.sqlite3
*.db
dump/
uploads/
session_data/
*.session

# ── ML Models & Artifacts ─────────────────────────────────────────────────────
*.joblib
*.onnx
*.pt
*.pth
*.bin
models/
checkpoints/

# ── Security, Reports & Audits ─────────────────────────────────────────────────
audit_*.json
audit-*.json
*.audit
security-report.*
trivy-*.json

# ── Build output ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.egg-info/
.eggs/

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── OS / Editor / IDE ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.antigravity/
